<div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-4 collaborators-grid">
  {% for collaborator in site.data.collaborators %}
    <div class="col">
      <div class="card collaborator-card h-100">
        <div class="collaborator-photo">
          {% assign image_path = collaborator.image | prepend: 'assets/img/' %}
          {%
            include figure.liquid
            loading="lazy"
            path=image_path
            class="collaborator-img"
            sizes="(min-width: 992px) 30vw, (min-width: 576px) 45vw, 90vw"
            alt=collaborator.name
          %}
        </div>
        <div class="card-body text-center">
          <h3 class="card-title collaborator-name">{{ collaborator.name }}</h3>
          <p class="collaborator-institute">{{ collaborator.affiliation }}</p>
          {% if collaborator.country %}
            <p class="collaborator-country text-muted">{{ collaborator.country }}</p>
          {% endif %}
          {% if collaborator.joint_papers %}
            <p class="collaborator-meta">
              <span class="badge badge-light">{{ collaborator.joint_papers }} joint paper{% if collaborator.joint_papers != 1 %}s{% endif %}</span>
            </p>
          {% endif %}
          {% if collaborator.research_areas %}
            <p class="collaborator-areas">
              {% for area in collaborator.research_areas %}
                <span class="badge badge-secondary">{{ area }}</span>
              {% endfor %}
            </p>
          {% endif %}
        </div>
      </div>
    </div>
  {% endfor %}
</div>
