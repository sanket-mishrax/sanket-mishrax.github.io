{% assign stats = site.data.research_areas.research_stats %}
<div class="research-impact">
  <table class="table table-bordered research-impact-table">
    <thead>
      <tr>
        <th scope="col">Metric</th>
        <th scope="col">Value</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td>Publications</td>
        <td>{{ stats.total_publications }}+</td>
      </tr>
      <tr>
        <td>Citations</td>
        <td>{{ stats.total_citations }}+</td>
      </tr>
      <tr>
        <td>h-index</td>
        <td>{{ stats.h_index }}</td>
      </tr>
      <tr>
        <td>i10-index</td>
        <td>{{ stats.i10_index }}</td>
      </tr>
      <tr>
        <td>Active since</td>
        <td>{{ stats.active_since }}</td>
      </tr>
    </tbody>
  </table>

  <p class="research-impact-profiles">
    <strong>Scholar profiles:</strong>
    {% for profile in stats.profiles %}
      <a href="{{ profile.url }}" rel="noopener noreferrer">{{ profile.label }}</a>{% unless forloop.last %} · {% endunless %}
    {% endfor %}
  </p>

  <p class="research-impact-note">
    <em>
      Citation metrics from
      <a href="https://scholar.google.com/citations?user={{ site.scholar_userid }}&hl=en">{{ stats.metrics_source }}</a>
      (updated {{ stats.metrics_updated }}).
    </em>
  </p>
</div>
