{% assign stats = site.data.research_areas.research_stats %}
<div class="research-impact">
  <div class="research-impact-metrics" role="table" aria-label="Research impact metrics">
    <div class="research-impact-metrics-header" role="row">
      <span role="columnheader">Metric</span>
      <span role="columnheader">Value</span>
    </div>
    <div class="research-impact-metric" role="row">
      <span class="metric-label" role="cell">Publications</span>
      <span class="metric-value" role="cell" data-count="{{ stats.total_publications }}" data-suffix="+">0+</span>
    </div>
    <div class="research-impact-metric" role="row">
      <span class="metric-label" role="cell">Citations</span>
      <span class="metric-value" role="cell" data-count="{{ stats.total_citations }}" data-suffix="+">0+</span>
    </div>
    <div class="research-impact-metric" role="row">
      <span class="metric-label" role="cell">h-index</span>
      <span class="metric-value" role="cell" data-count="{{ stats.h_index }}">0</span>
    </div>
    <div class="research-impact-metric" role="row">
      <span class="metric-label" role="cell">i10-index</span>
      <span class="metric-value" role="cell" data-count="{{ stats.i10_index }}">0</span>
    </div>
    <div class="research-impact-metric" role="row">
      <span class="metric-label" role="cell">Active since</span>
      <span class="metric-value" role="cell">{{ stats.active_since }}</span>
    </div>
  </div>

  <p class="research-impact-profiles">
    <strong>Scholar profiles:</strong>
    {% for profile in stats.profiles %}
      <a href="{{ profile.url }}" rel="noopener noreferrer">{{ profile.label }}</a>{% unless forloop.last %} · {% endunless %}
    {% endfor %}
  </p>

  <p class="research-impact-note">
    <em>
      Citation metrics from
      <a href="https://scholar.google.com/citations?user={{ site.scholar_userid }}&hl=en">{{ stats.metrics_source }}</a>
      (updated {{ stats.metrics_updated }}){% if stats.last_synced_at %}; last auto-sync {{ stats.last_synced_at }}{% endif %}.
    </em>
  </p>
</div>
